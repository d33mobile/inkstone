{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "strict": true,
    "outDir": "../dist",
    "rootDir": ".",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": false,
    "noEmit": true
  },
  "include": ["./**/*.ts"]
}
